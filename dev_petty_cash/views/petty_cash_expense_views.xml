<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_petty_cash_expense_tree" model="ir.ui.view">
        <field name="name">view.petty.cash.expense.tree</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <tree string="Petty Cash Expense">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="petty_journal_id" optional="show"/>
                <field name="company_id" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="expense_amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

<record id="view_petty_cash_expense_form2" model="ir.ui.view">
    <field name="name">view.petty.cash.expense.form2</field>
    <field name="model">petty.cash.expense</field>
    <field name="priority" eval="15"/>
    <field name="arch" type="xml">
        <form string="Gasto de Caja Chica">
            <header>
                <!--
                <button name="action_confirm" string="Confirm"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        
                <button name="action_validate" string="Validate"
                        type="object" class="btn-primary"
                        groups="dev_petty_cash.group_petty_manager"
                        attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                
                <button name="action_reconcile" string="Reconcile Payment"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'validate')]}"/>
                        
                <button name="action_draft" string="Set To Draft"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ('cancel', 'confirm'))]}"/>
                        
                <button name="action_cancel" string="Cancel"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ('confirm', 'validate'))]}"/>
                -->
                <!-- Sólo Usuario → confirma su propio borrador -->
                <button name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        groups="dev_petty_cash.group_petty_manager"
                        attrs="{'invisible': [('state','!=','draft')]}"/>
                                    
                <!-- Sólo Contador → vista previa de asientos contables -->
                <button name="action_preview_journal_entries"
                        string="Vista Previa Asientos"
                        type="object"
                        class="btn-info"
                        groups="dev_petty_cash.group_petty_accountant"
                        attrs="{'invisible': [('state','!=','confirm')]}"
                        help="Revisar los asientos contables antes de validar"/>
                        
                <!-- Sólo Contador → genera asientos contables -->
                <button name="action_validate"
                        string="Validate"
                        type="object"
                        class="btn-primary"
                        groups="dev_petty_cash.group_petty_accountant"
                        attrs="{'invisible': [('state','!=','confirm')]}"/>
                            
                <!-- Sólo Contador → concilia pagos -->
                <button name="action_reconcile"
                        string="Reconcile Payment"
                        type="object"
                        class="btn-primary"
                        groups="dev_petty_cash.group_petty_accountant"
                        attrs="{'invisible': [('state','!=','validate')]}"/>
                                    
                <!-- Usuario y Manager pueden volver a borrador -->
                <button name="action_draft"
                        string="Set To Draft"
                        type="object"
                        attrs="{'invisible': [('state','not in',('cancel','confirm'))]}"/>
                                    
                <!-- Sólo Manager → puede cancelar -->
                <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-danger"
                        groups="dev_petty_cash.group_petty_manager"
                        attrs="{'invisible': [('state','not in',('confirm','validate'))]}"/>                
                <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate,done"/>
            </header>
            <sheet>
                <div class="o_button_box" name="button_box">
                    <button name="action_view_payment"
                            type="object"
                            class="o_stat_button"
                            icon="fa-edit"
                            attrs="{'invisible': [('payment_count', '=', 0)]}">
                        <field name="payment_count" widget="statinfo" string="Payments"/>
                    </button>
                    <button name="action_view_preview_moves"
                            type="object"
                            class="o_stat_button"
                            icon="fa-eye"
                            attrs="{'invisible': [('preview_count', '=', 0)]}">
                        <field name="preview_count" widget="statinfo" string="Vista Previa"/>
                    </button>
                    <button name="action_open_product_lines_full" type="object" class="btn-secondary o_stat_button" icon="fa-list" string="Líneas Pantalla Completa" help="Ver y editar todas las líneas de productos de este gasto en pantalla completa"/>
                </div>
                <h3>
                    <field name="name" readonly="1"/>
                </h3>
                <group>
                    <group>
                        <field name="employee_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="payment_journal_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="petty_journal_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    </group>
                    <group>
                        <field name="date" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="user_id" required="1" readonly="1"/>
                        <field name="company_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        <field name="payment_ids" widget="many2many_tags" invisible="1"/>
                    </group>
                </group>
                
                <notebook>
                    <page string="Expense Lines">
                        <field name="expense_lines" context="{'default_currency_id': currency_id}"
                            options="{'no_create': True, 'no_delete': True}" mode="tree,form"
                            attrs="{'readonly': [('state', '=', 'done')]}">
                            <tree attrs="{'readonly': [('parent.state', '=', 'done')]}" decoration-info="expense_state == 'draft'" decoration-warning="expense_state == 'confirm'" decoration-success="expense_state == 'done'">
                                <field name="date_expense" required="1"/>
                                <field name="invoice_number" required="1"/>
                                <field name="supplier_id" required="1"/>
                                <field name="note_expense" optional="show"/>
                                <field name="invoice_amount" widget="monetary" force_save="1" readonly="1" sum="Total Facturas"/>
                                <field name="invoice_tax_id" domain="[('type_tax_use', 'in', ['purchase', 'none'])]" optional="show"/>
                                <field name="tax_amount" widget="monetary" sum="Total Impuestos"/>
                                <field name="amount" widget="monetary" force_save="1" readonly="1" sum="Total General"/>
                                <field name="attachment_count" string="Docs" optional="show"/>
                                <field name="expense_state" string="Estado" optional="show"/>
                                <field name="currency_id" invisible="1"/>
                                <button string="" type="object" name="open_line_form" class="btn-primary o_edit_button" icon="fa-pencil" title="Editar Línea"/>
                                <button string="" type="object" name="action_view_attachments" class="btn-secondary" icon="fa-paperclip" title="Ver Documentos Adjuntos" attrs="{'invisible': [('attachment_count', '=', 0)]}"/>
                            </tree>
                            <form attrs="{'readonly': [('parent.state', '=', 'done')]}" width="1200">
                                <sheet>
                                    <!-- Campo expense_state invisible necesario para los ribbons -->
                                    <field name="expense_state" invisible="1"/>
                                    
                                    <div>
                                        <widget name="web_ribbon"
                                                title="BORRADOR"
                                                bg_color="bg-secondary"
                                                attrs="{'invisible': [('expense_state', '!=', 'draft')]}"/>
                                        <widget name="web_ribbon"
                                                title="CONFIRMADO"
                                                bg_color="bg-warning"
                                                attrs="{'invisible': [('expense_state', '!=', 'confirm')]}"/>
                                        <widget name="web_ribbon"
                                                title="VALIDADO"
                                                bg_color="bg-primary"
                                                attrs="{'invisible': [('expense_state', '!=', 'validate')]}"/>
                                        <widget name="web_ribbon"
                                                title="COMPLETADO"
                                                bg_color="bg-success"
                                                attrs="{'invisible': [('expense_state', '!=', 'done')]}"/>
                                        <widget name="web_ribbon"
                                                title="CANCELADO"
                                                bg_color="bg-danger"
                                                attrs="{'invisible': [('expense_state', '!=', 'cancel')]}"/>
                                    </div>
                                    <div class="oe_title">
                                        <h1>
                                            <label for="invoice_number"/>
                                            <field name="invoice_number" placeholder="Número de Factura..." required="1" style="width: 100%; min-width: 300px;"/>
                                        </h1>
                                        <h3>
                                            <label for="supplier_id"/>
                                            <field name="supplier_id" placeholder="Seleccionar Proveedor..." required="1" style="width: 100%; min-width: 400px;"/>
                                        </h3>
                                    </div>
                                    
                                    <group>
                                        <group string="Información General">
                                            <field name="date_expense" required="1" style="width: 100%; min-width: 200px;"/>
                                            <field name="note_expense" placeholder="Descripción del gasto..." style="width: 100%; min-width: 300px;"/>
                                        </group>
                                        <group string="Información Financiera">
                                            <field name="invoice_tax_id" domain="[('type_tax_use', 'in', ['purchase', 'none'])]" style="width: 100%; min-width: 250px;"/>
                                            <field name="tax_amount" widget="monetary" style="width: 100%; min-width: 200px;"/>
                                            <field name="invoice_amount" widget="monetary" force_save="1" readonly="1" style="width: 100%; min-width: 200px;"/>
                                            <div class="o_td_label">
                                                <strong>Total:</strong>
                                            </div>
                                            <field name="amount" widget="monetary" force_save="1" readonly="1" class="oe_subtotal_footer_separator" style="width: 100%; min-width: 200px; font-weight: bold;"/>
                                            <field name="currency_id" invisible="1"/>
                                        </group>
                                    </group>
                                
                                    <notebook>
                                        <page string="Líneas de Productos del Gasto">
                                            <field name="product_lines">
                                                <tree editable="bottom" decoration-muted="is_credit_note_line == True" width="1200">
                                                    <field name="product_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                                                    <field name="quantity" sum="Total Cantidad"/>
                                                    <field name="price_unit" widget="monetary"/>
                                                    <field name="price_subtotal" sum="Total Subtotal" widget="monetary"/>
                                                    <field name="tax_id" optional="show"/>
                                                    <field name="tax_amount" widget="monetary" sum="Total Impuestos"/>
                                                    <field name="account_analytic_id" string="Cuenta Analítica" optional="show"/>
                                                    <field name="dest_location_id" string="Almacén de Entrega" optional="show"/>
                                                    <field name="phase_id" string="Fase" optional="show"/>
                                                    <field name="vehiculo_id" string="Vehículo" optional="show"/>
                                                    <field name="stock_move_line_id" string="Entrada Inventario" optional="show"/>
                                                    <field name="is_credit_note_line" string="Nota Crédito" optional="hide"/>
                                                    <field name="currency_id" invisible="1"/>
                                                </tree>
                                            </field>
                                        </page>
                                        
                                        <page string="Documentos Adjuntos">
                                            <group string="Facturas, Recibos y otros Documentos">
                                                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                                            </group>
                                        </page>
                                        
                                        <page string="Bitácora y Actividades">
                                            <div class="oe_chatter">
                                                <field name="message_follower_ids" widget="mail_followers" nolabel="1"/>
                                                <field name="activity_ids" widget="mail_activity" nolabel="1"/>
                                                <field name="message_ids" widget="mail_thread" nolabel="1"/>
                                            </div>
                                        </page>
                                    </notebook>
                                </sheet>
                                
                            </form>
                        </field>
                        <group name="note_group" col="6" class="mt-2 mt-md-0">
                            <group colspan="4">
                                <field name="note" nolabel="1" placeholder="Terms and conditions..."/>
                            </group>
                            <group class="o_subtotal_footer o_right" colspan="2" name="sale_total">
                                <field name="balance" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="expense_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_tax_amount"/>
                                
                                <div class="o_subtotal_footer_separator o_inline o_td_label">
                                    <label for="remaining_balance"/>
                                </div>

                                <field name="remaining_balance" nolabel="1" class="o_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <div class="o_clear"/>
                        </group>
                    </page>
                    <page name="asiento_de_diario" string="Asiento de Diario">
                        <field name="account_move_ids_expense" readonly="1">
                            <tree string="Asientos de Gastos">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="journal_id"/>
                                <field name="state"/>
                                <field name="amount_total_signed"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>

    <record id="dev_petty_cash_expense_filter" model="ir.ui.view">
        <field name="name">petty.cash.expense.filter</field>
        <field name="model">petty.cash.expense</field>
        <field name="arch" type="xml">
            <search string="Petty Cash">
                <field name="name" string='Petty Cash'/>
                <field name="employee_id"/>
                <field name="date"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Requested" name="request" domain="[('state','=','request')]"/>
                <filter string="Approved" name="approve" domain="[('state','=','approve')]"/>
                <filter string="Cancel" name="cancel" domain="[('state','=','cancel')]"/>
                <filter string="Date" name="date" date="date"/>

                <group expand="0" string="Group By">
                    <filter name="employee_id" string="Employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter name="petty_journal_id" string="Petty Cash Journal" domain="[]" context="{'group_by':'petty_journal_id'}"/>
                    <filter name="company_id" string="Company" domain="[]" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

<record id="action_petty_cash_expense_form2" model="ir.actions.act_window">
    <field name="name">Petty Cash Expense Form</field>
    <field name="res_model">petty.cash.expense</field>
    <field name="view_mode">tree,form</field>
    <field name="view_ids" eval="[(5, 0, 0), 
                                   (0, 0, {'view_mode': 'tree', 'view_id': ref('view_petty_cash_expense_tree')}), 
                                   (0, 0, {'view_mode': 'form', 'view_id': ref('view_petty_cash_expense_form2')})]"/>
</record>

<menuitem name="Petty Cash Expense Form" id="menu_petty_cash_expense_form2"
          parent="dev_petty_cash_menu"
          action="action_petty_cash_expense_form2" sequence="5"/>

<!-- Vista tree editable para pantalla completa -->
<record id="view_petty_expense_line_product_tree_full" model="ir.ui.view">
    <field name="name">petty.expense.line.product.tree.full</field>
    <field name="model">petty.expense.line.product</field>
    <field name="arch" type="xml">
        <tree editable="bottom" string="Líneas de Productos de Gasto" create="true" delete="true">
            <field name="expense_line_id"/>
            <field name="product_id"/>
            <field name="quantity"/>
            <field name="price_unit"/>
            <field name="price_subtotal"/>
            <field name="tax_id"/>
            <field name="tax_amount"/>
            <field name="account_analytic_id"/>
            <field name="dest_location_id"/>
            <field name="phase_id"/>
            <field name="vehiculo_id"/>
            <field name="stock_move_line_id"/>
            <field name="is_credit_note_line"/>
            <field name="currency_id" invisible="1"/>
        </tree>
    </field>
</record>

<!-- Acción para abrir la vista de lista editable -->
<record id="action_petty_expense_line_product_full" model="ir.actions.act_window">
    <field name="name">Líneas de Productos de Gasto</field>
    <field name="res_model">petty.expense.line.product</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_petty_expense_line_product_tree_full"/>
    <field name="context">{}</field>
</record>

<!-- Menú para acceder a la vista pantalla completa -->
<menuitem id="menu_petty_expense_line_product_full" name="Líneas de Productos de Gasto" parent="dev_petty_cash_menu" action="action_petty_expense_line_product_full" sequence="99"/>

</odoo>
